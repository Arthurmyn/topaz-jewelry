# Copy to .env to override defaults. Everything works without a .env for local development.
SECRET_KEY=dev-secret-change-me
SITE_URL=http://localhost:8080
HTTP_PORT=8080
SITE_ADDRESS=:80

# Feature flags (restart the stack after changing)
FEATURE_ACCOUNTS=false
FEATURE_PAYMENTS=false

# Payments
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Public contact
WHATSAPP_NUMBER=77000000000

# Object storage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=topaz-media
